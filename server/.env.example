# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB Atlas or Local Community Edition)
MONGODB_URI=mongodb://127.0.0.1:27017/examsphere

# Optional Redis Scalability Layer (for Socket.IO adapter, caching, and rate limiting)
# Leave empty in local development to run seamlessly with built-in in-memory fallback
REDIS_URL=redis://127.0.0.1:6379

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here_minimum_32_characters
JWT_EXPIRES_IN=7d

# Client URL for CORS
CLIENT_URL=http://localhost:5173

# Optional: Google Gemini API Key for AI features (Question Generation & Deep Analysis)
# If left empty, ExamSphere operates automatically in Fallback Mode: Rule-Based Recommendation Engine
GEMINI_API_KEY=

# Proctoring & Acoustic Integrity Mode: 'DISABLED' | 'RULE_BASED' | 'ML_ASSISTED'
VOICE_INTEGRITY_MODE=RULE_BASED

# High-Concurrency Rate Limiter Overrides (Tuned for 2,000+ Concurrent Students)
RATE_LIMIT_AUTH_MAX=100
RATE_LIMIT_ANSWER_MAX=1200
RATE_LIMIT_HEARTBEAT_MAX=600
RATE_LIMIT_INTEGRITY_MAX=300
RATE_LIMIT_GRAPHQL_MAX=600
RATE_LIMIT_API_MAX=2000

# Data Retention Compliance (Days)
RETENTION_INTEGRITY_DAYS=90
RETENTION_AUDIT_DAYS=365
